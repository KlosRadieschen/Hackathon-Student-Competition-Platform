{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "frontend/public",
    "rootDir": "frontend/src",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": ["frontend/src/**/*.ts"]
}
